{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ProAnima/unity-version-control-mcp/blob/main/templates/fleet/workspaces.schema.json",
  "title": "UVCS MCP workspace fleet",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "workspaces"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "defaults": {
      "$ref": "#/$defs/settings"
    },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "safety": {
            "enum": ["readonly", "guarded", "standard"]
          },
          "mode": {
            "enum": ["readonly", "standard"]
          },
          "installSource": {
            "enum": ["npm", "local"]
          },
          "cmPath": {
            "type": "string",
            "minLength": 1
          },
          "allowedRepos": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "checkinMaxFiles": {
            "type": "integer",
            "minimum": 1
          },
          "tokenTtlSec": {
            "type": "integer",
            "minimum": 1
          },
          "auditLog": {
            "type": "string",
            "minLength": 1
          },
          "readTimeoutMs": {
            "type": "integer",
            "minimum": 1
          },
          "writeTimeoutMs": {
            "type": "integer",
            "minimum": 1
          },
          "maxOutputBytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "safety": {
          "enum": ["readonly", "guarded", "standard"]
        },
        "mode": {
          "enum": ["readonly", "standard"]
        },
        "installSource": {
          "enum": ["npm", "local"]
        },
        "cmPath": {
          "type": "string",
          "minLength": 1
        },
        "allowedRepos": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checkinMaxFiles": {
          "type": "integer",
          "minimum": 1
        },
        "tokenTtlSec": {
          "type": "integer",
          "minimum": 1
        },
        "auditLog": {
          "type": "string",
          "minLength": 1
        },
        "readTimeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "writeTimeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
